# 应用
APP_NAME=ai-agent-platform
ENV=dev
DEBUG=true
API_PREFIX=/api/v1

# 数据库（生产 PostgreSQL）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_platform
DB_ECHO=false

# 测试可用 SQLite：
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Redis
REDIS_URL=redis://localhost:6379/0

# 安全（生产必须替换，且通过环境变量注入，禁止入库）
SECRET_KEY=dev-only-change-me
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-unique-random-secret-at-least-32-characters

# 编排兜底参数
MAX_ITERATIONS=20
NODE_TIMEOUT_MS=30000
TASK_TIMEOUT_MS=300000
ROUTE_CONFIDENCE_THRESHOLD=0.6
